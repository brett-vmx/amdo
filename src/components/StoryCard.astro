---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  duration: string;
  cover: ImageMetadata;
}

const { slug, title, duration, cover } = Astro.props;
---

<a
  href={`/story/${slug}`}
  data-slug={slug}
  class="story-card group block bg-surface rounded-card overflow-hidden shadow-sm
         transition-all duration-200 hover:scale-[1.03] hover:shadow-xl
         focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
>
  <div class="aspect-square overflow-hidden bg-navy/5">
    <Image
      src={cover}
      alt={`Cover image for ${title}`}
      width={512}
      height={512}
      class="h-full w-full object-cover"
      loading="lazy"
    />
  </div>

  <!-- White info area -->
  <div class="bg-surface p-3 sm:p-4">
    <h3 class="font-bold leading-snug text-navy group-hover:text-teal transition-colors text-lg">
      {title}
    </h3>
    {duration && (
      <p class="mt-1 text-sm text-gray-500">{duration}</p>
    )}
  </div>
</a>
