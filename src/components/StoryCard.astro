---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  slug: string;
  title: string;
  cover: ImageMetadata;
}

const { slug, title, cover } = Astro.props;
---

<a
  href={`/story/${slug}`}
  data-slug={slug}
  class="story-card group block bg-surface rounded-card overflow-hidden shadow-sm
         transition-all duration-200 hover:scale-[1.03] hover:shadow-xl
         focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-2"
>
  <div class="aspect-video overflow-hidden bg-navy/5">
    <Image
      src={cover}
      alt={`Cover image for ${title}`}
      width={512}
      height={288}
      class="h-full w-full object-cover"
      loading="lazy"
    />
  </div>

  <!-- Navy info area -->
  <div class="bg-navy p-3 sm:p-4">
    <h3 class="font-bold leading-snug text-white group-hover:text-teal-light transition-colors text-lg">
      {title}
    </h3>
  </div>
</a>
